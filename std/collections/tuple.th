include combinators

forall a b type tuple contains
    tuple a b

forall a b let fst be the fn tuple a b a lambda tuple x _ x

forall a b let snd be the fn tuple a b b lambda tuple _ y y

--  turn a curried function into a function that
--  takes a tuple instead

forall a b c let uncurry be the 
    fn fn a fn b c fn tuple a b c 
    lambda f lambda tuple a b    f a b

forall a b c let curry be the 
    fn fn tuple a b c fn a fn b c 
    lambda f lambda a lambda b f tuple a b

--  bifunctor

forall a b c d let bimap be the 
    fn fn a c fn fn b d fn tuple a b tuple c d 
    lambda f lambda g lambda tuple x y    tuple f x g y

forall a b c let map_fst be the 
    fn fn a c fn tuple a b tuple c b 
    lambda f bimap f 
        the fn b b identity

forall a b c let map_snd be the 
    fn fn b c fn tuple a b tuple a c 
    lambda f bimap 
        identity 
        f

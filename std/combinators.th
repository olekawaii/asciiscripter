forall a let identity be the fn a a lambda x x

forall a b c let flip be the 
    fn fn a fn b c fn b fn a c 
    lambda f lambda a lambda b f b a

forall a b c let compose be the 
    fn fn b c fn fn a b fn a c 
    lambda g lambda f lambda x g f x

forall a b let apply be the fn fn a b fn a b identity

forall a b let const be the fn a fn b a lambda x lambda _ x

include bool whole ordering list

--  a recursive definition of a natural number 
--  using church numerals. a nat is either one
--  or the successor of a nat
--  
--  one              = 1
--  succ one         = 2
--  succ (succ one)  = 3

type nat contains
    one
    succ nat

let sum_nat be the fn nat fn nat nat 
    lambda x match x
        case one        succ
        case succ a     compose 
            succ 
            sum_nat a

let product_nat be the fn nat fn nat nat 
    lambda x lambda y match x
        case one        y
        case succ a     sum_nat y product_nat a y

--  decrement a nat. since decrementing one is 
--  zero, it returns a whole number, which has 
--  a zero variant.

let decrement_nat be the fn nat whole lambda x pred x

let compare_nat be the fn nat fn nat ordering
    lambda x lambda y match tuple x y
        case tuple succ a succ b     compare_nat a b
        case tuple succ _ one        gt
        case tuple one    succ _     lt

let eq_nat be the fn nat fn nat bool 
    lambda x lambda y eq_ordering eq compare_nat x y

--  check that the first nat is greater than
--  the second one

let greater be the fn nat fn nat bool 
    lambda a lambda b eq_ordering gt compare_nat a b

--  find the greatest common denominator of two 
--  nats

let gcd be the fn nat fn nat nat 
    gcd_helper i ii

let gcd_helper be the fn nat fn nat fn nat fn nat nat 
    lambda output lambda try lambda x lambda y match 
        or greater try x greater try y
        case true                    output
        case false                   gcd_helper
            if
                and 
                    divisible nat_to_whole x nat_to_whole try 
                    divisible nat_to_whole y nat_to_whole try 
                try
                output
            succ try
            x
            y

--  find the least common multiple of two nats

let lcm be the fn nat fn nat nat 
    lambda x lambda y
        match 
            divide_exactly 
                nat_to_whole product_nat x y 
                nat_to_whole gcd x y 
            case none                    i
            case some x                  match x 
                case pred one                i
                case pred succ x             x

type coordinate contains
    coordinate int int

forall a let repeat be the 
    fn nat fn fn a a fn a a 
    lambda count lambda f lambda x match count
        case one                  f x
        case succ new_count       f repeat new_count f x

let sum_coordinate be the fn coordinate fn coordinate coordinate 
    lambda coordinate x_i y_i lambda coordinate x_ii y_ii
        coordinate sum_int x_i x_ii sum_int y_i y_ii

let eq_coordinate be the fn coordinate fn coordinate bool 
    lambda coordinate a b lambda coordinate c d  and eq_int a c eq_int b d


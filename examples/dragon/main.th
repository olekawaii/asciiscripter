let right_half be the list frame layer
    layer
        entirely shift_by pos vi pos vii layer
            cycle cat blow roar
            cycle for
                iii
                rotate_right
                entirely by xv shift east fire
        cycle append new_frame entirely
            shift_by pos x pos i
            dragon_wing
    layer
        cycle slow ii entirely shift_by pos iv neg i dragon_foot
        cycle for ii rotate for ii extend art x vii
